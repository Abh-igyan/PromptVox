{
  "name": "promptvox-voice-helper",
  "displayName": "PromptVox: Antigravity Voice Typing",
  "description": "In-built speech-to-text mic for Antigravity in VS Code with zero-lag bilingual Hinglish support",
  "version": "1.1.0",
  "publisher": "AbhigyanTiwari",
  "author": {
    "name": "Abhigyan Tiwari",
    "email": "abhigyanph@gmail.com",
    "url": "https://github.com/Abh-igyan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abh-igyan/PromptVox"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.voiceType",
        "title": "PromptVox: Voice Type (Alt+V)",
        "icon": "$(mic)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity.voiceType",
        "key": "alt+v",
        "mac": "alt+v"
      },
      {
        "command": "antigravity.voiceType",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity.voiceType",
          "when": "view == antigravity.panel",
          "group": "navigation"
        }
      ]
    }
  }
}
